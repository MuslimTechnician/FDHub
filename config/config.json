{
  "repoName": "FDHub",
  "repoDescription": "An F-Droid repository for apps that are not available in F-Droid and other repos, installable from any F-Droid client.",
  "repoUrl": "https://fdhub-mt.netlify.app/repo",
  "webBaseUrl": "https://fdhub-mt.netlify.app",

  "keystoreAlias": "repokey",

  "schedule": {
    "cron": "0 0 * * *",
    "timezone": "UTC"
  },

  "batch": {
    "size": 50,
    "maxParallel": 10
  },

  "rateLimit": {
    "requestsPerHour": 4500,
    "interRequestDelayMs": 200,
    "maxRetries": 5,
    "backoffBaseSeconds": 1.0,
    "backoffMaxSeconds": 60.0
  },

  "strictCertificateMode": false
}
